# Environment variable template for the Autonomous Production Reliability Platform.
#
# This file contains PLACEHOLDERS ONLY. Copy it to `.env` and fill in real
# values locally; `.env` is gitignored and must never be committed.
#
# No variables are consumed by any code yet (Phase 0.1 has no application
# code). This file exists to establish the convention early.

# --- General ---
ENVIRONMENT=local

# --- Placeholders for future phases (not yet used) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# REDIS_URL=redis://localhost:6379
# AI_PROVIDER_API_KEY=changeme
