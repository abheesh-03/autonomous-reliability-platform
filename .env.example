# Environment variable template for the Autonomous Production Reliability Platform.
#
# This file contains PLACEHOLDERS ONLY. Copy it to `.env` and fill in real
# values locally; `.env` is gitignored and must never be committed.
#
# checkout-service consumes the CHECKOUT_*_BASE_URL variables below.
# Docker Compose supplies its own container-network values for those
# directly in docker-compose.yml, so .env does not need to set them to
# run the Compose environment — they're only useful for overriding
# checkout-service's defaults when running it outside Compose.

# --- General ---
ENVIRONMENT=local

# --- PostgreSQL (local development only) ---
# Used by docker-compose.yml. The password below is a local placeholder,
# not a production credential — change it if you like, but never reuse
# it anywhere real.
POSTGRES_DB=reliability_platform_dev
POSTGRES_USER=reliability_platform
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432

# --- checkout-service downstream URLs (optional local overrides) ---
# checkout-service already defaults to these same values when run
# outside Docker Compose, so these are optional.
# CHECKOUT_PAYMENT_BASE_URL=http://localhost:8081
# CHECKOUT_INVENTORY_BASE_URL=http://localhost:8082
# CHECKOUT_NOTIFICATION_BASE_URL=http://localhost:8083

# --- Grafana (local development only) ---
# Used by docker-compose.yml. The password below is a local placeholder,
# not a production credential — Grafana is only reachable on localhost
# in this environment. Anonymous access is disabled.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local_dev_only_change_me

# --- investigator-service (Phase 5, local development only) ---
# Real AI investigation is opt-in: leave INVESTIGATOR_LLM_API_KEY unset
# and the service still starts and still serves evidence-only
# responses — POST /api/v1/investigations just returns an explicit 503
# instead of a real investigation. Never commit a real key here; this
# file is a template only. See docs/architecture/phase-5-ai-investigator.md.
# INVESTIGATOR_LLM_API_KEY=sk-your-real-openai-key
# INVESTIGATOR_LLM_MODEL=gpt-4o-mini
# INVESTIGATOR_LLM_BASE_URL=

# --- retrieval-service (Phase 6, local development only) ---
# retrieval-service DOES hold PostgreSQL credentials (reused from the
# POSTGRES_* variables above) -- it owns reliability.retrieval_chunks.
# Unlike investigator-service, it never reads
# CONTROL_PLANE_WEBHOOK_TOKEN/CONTROL_PLANE_LIFECYCLE_TOKEN either.
#
# RETRIEVAL_EMBEDDING_PROVIDER defaults to "local" -- a deterministic,
# offline LEXICAL feature-hashing embedding (NOT a neural/semantic
# model; see services/retrieval-service's embeddings/provider.py).
# This is what normal development, CI, and scripts/verify-rag.sh all
# use; it needs no credential and makes no network call.
# RETRIEVAL_EMBEDDING_PROVIDER=local
#
# Set to "openai" to use a real embedding model (e.g.
# text-embedding-3-small) instead -- this REQUIRES
# RETRIEVAL_EMBEDDING_API_KEY, a credential DISTINCT from
# investigator-service's own INVESTIGATOR_LLM_API_KEY (this service
# has no reason to ever see that one). Selecting "openai" without a
# configured key is an explicit startup error, never a silent
# fallback to the local provider. Never commit a real key here; this
# file is a template only. See
# docs/architecture/phase-6-rag-retrieval.md.
# RETRIEVAL_EMBEDDING_PROVIDER=openai
# RETRIEVAL_EMBEDDING_API_KEY=sk-your-real-openai-key
# RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small
# RETRIEVAL_EMBEDDING_BASE_URL=

# --- Placeholders for future phases (not yet used) ---
# REDIS_URL=redis://localhost:6379
