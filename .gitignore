# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- IDE artifacts ---
.vscode/
.idea/
*.iml
*.swp
*.swo

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-error.log*
.next/
out/
*.tsbuildinfo

# --- Playwright (Phase 9 Gate F e2e) ---
playwright-report/
test-results/
blob-report/

# --- Phase 10 AI evaluation reports (regenerated on every run) ---
evals/reports/

# --- Java ---
target/
*.class
*.jar

# --- Go ---
/bin/
*.exe
*.test

# --- Terraform ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
# Phase 13: a filled-in tfvars file is where a real AWS account id
# would otherwise land -- never committed. *.example files (e.g.
# terraform.tfvars.example) are explicitly re-allowed below.
*.tfvars
!*.tfvars.example

# --- Logs / coverage ---
*.log
logs/
coverage/
*.cover
.coverage

# --- Phase 11A incident intelligence catalog ---
# The generic build/ and coverage/ patterns above are unanchored, so
# they would otherwise also swallow catalog/build/ (a real, partially
# version-controlled generated-artifact directory) and catalog/coverage/
# (a real Python source package -- tracker.py -- not a generated
# coverage report). Explicitly un-ignore both, then re-ignore only the
# genuinely ad-hoc, non-reviewable local outputs under catalog/build/
# (anything written to a non-default --output path).
!catalog/build/
!catalog/coverage/
catalog/build/local/
catalog/build/*.local.json
