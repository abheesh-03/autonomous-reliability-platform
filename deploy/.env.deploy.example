# Phase 17A deployment secrets/environment template.
#
# THIS FILE CONTAINS PLACEHOLDERS ONLY. It is the deployment-specific
# counterpart of the repository root's .env.example (which remains the
# LOCAL-DEVELOPMENT template, completely unchanged by Phase 17A).
# Copy it to deploy/.env.deploy and let
# deploy/scripts/init-deploy-secrets.sh fill in real, independently
# generated values -- never hand-write a real secret into this file.
# deploy/.env.deploy is gitignored (see deploy/.gitignore) and must
# never be committed.
#
# This file is read ONLY by the root docker-compose.yml PLUS
# deploy/docker-compose.override.yml (there is no separate
# deploy/docker-compose.yml -- a prior comment here wrongly implied
# one existed) -- the real local-development docker-compose.yml and
# its own .env are completely unaffected by anything in this file.

# ============================================================
# Identity: who this deployment is, and where it is reachable
# ============================================================

# Distinct Compose project name -- guarantees separate named volumes,
# networks, and container names from the developer's own long-running
# local-dev stack (which uses Compose's own default project-name
# derivation). Required so `deploy/scripts/deploy-up.sh` can NEVER
# collide with, stop, or share a volume with the developer's existing
# environment.
#
# CORRECTION ROUND: deliberately left UNSET here, not hardcoded.
# Every deploy/scripts/*.sh file already reads this as
# "${COMPOSE_PROJECT_NAME:-arp-deploy}" (a shell fallback that only
# applies when the variable is genuinely unset/empty) -- hardcoding a
# real value on this line meant that every script's own `set -a;
# source deploy/.env.deploy; set +a` UNCONDITIONALLY OVERWROTE any
# project name already exported in the calling shell (e.g. CI's own
# job-level `COMPOSE_PROJECT_NAME: arp-deploy-ci`), silently defeating
# that isolation. Set this explicitly in your own shell/CI job
# environment BEFORE sourcing this file if you need a non-default
# name; leave it unset to get the documented "arp-deploy" default
# every script already falls back to.
# COMPOSE_PROJECT_NAME=arp-deploy

# The real, externally-reachable HTTPS origin for this deployment --
# the SINGLE source of truth consumed by: Better Auth's baseURL/
# trustedOrigins, the Secure-cookie flag, the BFF's own origin guard,
# the onboarding setup snippets' ingestion URL, and Caddy's own site
# block. No placeholder is accepted here by the preflight check
# (deploy/scripts/preflight.sh) -- it must be a real "https://" URL
# with a real hostname, even if that hostname currently resolves
# nowhere (local proof uses a .test/.localhost-style development
# domain -- see deploy/README.md's "Local HTTPS proof" section).
DEPLOYMENT_PUBLIC_ORIGIN=https://CHANGE_ME.example

# TLS mode Caddy uses for the site block above:
#   - "internal": Caddy's own built-in local CA issues a certificate
#     automatically -- the correct mode for the required local proof
#     (see deploy/README.md), and for any domain Caddy cannot complete
#     real ACME validation for yet.
#   - "acme": a real, publicly trusted certificate via Let's Encrypt
#     ACME HTTP-01, for an actual, DNS-resolvable, internet-reachable
#     domain -- Phase 17B (actual hosting), never issued or claimed by
#     this phase.
DEPLOYMENT_TLS_MODE=internal

# ============================================================
# PostgreSQL -- bootstrap/owner role (migrations + role setup ONLY)
# ============================================================
# This role is the schema OWNER -- used by the `flyway` migration
# container and, once, by deploy/scripts/init-deploy-secrets.sh to
# create the two new least-privileged runtime roles below
# (deploy/sql/01-create-runtime-roles.sql.template). It is NEVER given
# to control-plane, retrieval-service, web-console, or
# agent-runtime-service at runtime in deploy/docker-compose.yml --
# see "runtime roles" below for what they actually use.
POSTGRES_DB=reliability_platform
POSTGRES_BOOTSTRAP_USER=reliability_owner
POSTGRES_BOOTSTRAP_PASSWORD=

# ============================================================
# Grafana admin credential (correction round).
# ============================================================
# The base docker-compose.yml falls back to the literal placeholder
# "local_dev_only_change_me" when GRAFANA_ADMIN_PASSWORD is unset --
# correct for local development, never acceptable for a deployment.
# Generated by init-deploy-secrets.sh; Grafana itself is internal-only
# in this deployment (no published port), but a well-known placeholder
# admin password is still a real, avoidable weakness for anything
# reachable on the internal network.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ============================================================
# PostgreSQL -- least-privileged runtime roles (generated)
# ============================================================
# control_plane_app / retrieval_app are NEW roles, created only in a
# deployment (deploy/sql/01-create-runtime-roles.sql.template) --
# SELECT/INSERT/UPDATE/DELETE on exactly the tables each service's own
# repository code touches, never CREATE/ALTER/DROP, never role
# management, never superuser. web_console / agent_runtime reuse the
# EXISTING Phase 14 / Phase 7 roles and scripts unchanged (already
# correctly least-privileged -- see those scripts' own docstrings).
CONTROL_PLANE_APP_DB_PASSWORD=
RETRIEVAL_APP_DB_PASSWORD=
WEB_CONSOLE_DB_PASSWORD=
AGENT_RUNTIME_DB_PASSWORD=

# ============================================================
# Application secrets (same names/semantics as the repository root's
# .env.example -- see that file's own comments for the full per-token
# boundary table; not repeated here).
# ============================================================
BETTER_AUTH_SECRET=
SERVICE_ASSERTION_SIGNING_SECRET=
SERVICE_ASSERTION_TRUSTED_ISSUERS=web-console,agent-runtime-service,investigator-service
SERVICE_ASSERTION_AUDIENCE_CONTROL_PLANE=control-plane
SERVICE_ASSERTION_AUDIENCE_INVESTIGATOR=investigator-service
SERVICE_ASSERTION_TRUSTED_ISSUERS_INVESTIGATOR=agent-runtime-service

CONTROL_PLANE_WEBHOOK_TOKEN=
CONTROL_PLANE_LIFECYCLE_TOKEN=
CONTROL_PLANE_REMEDIATION_PROPOSAL_TOKEN=
CONTROL_PLANE_REMEDIATION_APPROVER_TOKEN=
CONTROL_PLANE_REMEDIATION_EXECUTOR_TOKEN=
TOOL_GATEWAY_EXECUTION_TOKEN=
CONTROL_PLANE_INTERNAL_READ_TOKEN_AGENT_RUNTIME=
CONTROL_PLANE_INTERNAL_READ_TOKEN_INVESTIGATOR=
CONTROL_PLANE_INTERNAL_READ_TOKEN_TOOL_GATEWAY=
INVESTIGATOR_INTERNAL_READ_TOKEN_AGENT_RUNTIME=
RETRIEVAL_INTERNAL_READ_TOKEN_INVESTIGATOR=

# Real credential, held ONLY by this deployment's own disposable
# payment-service demo -- fault injection stays OFF by default even
# though the token exists (PAYMENT_FAULT_INJECTION_ENABLED below is
# the actual gate; this token alone enables nothing).
PAYMENT_FAULT_INJECTION_TOKEN=
PAYMENT_REMEDIATION_TOKEN=
PAYMENT_FAULT_INJECTION_ENABLED=false

# ============================================================
# Fail-closed deployment posture (preflight-enforced -- see
# deploy/scripts/preflight.sh; these are not merely defaults, the
# preflight REJECTS a launch if any of these three is not exactly
# this value).
# ============================================================
CONTROL_PLANE_REQUIRE_ORGANIZATION_CONTEXT=true
WEB_CONSOLE_USE_SECURE_COOKIES=true
WEB_CONSOLE_DISABLE_SPECIAL_RATE_LIMITS=false

# The explicit legacy-vs-multi-tenant ingestion boundary (see the
# repository root .env.example's own comment for the full rationale).
# Kept TRUE in this deployment template so the internal demo stack
# (Alertmanager -> control-plane webhook, entirely over the private
# Docker network, never reachable through Caddy -- see
# deploy/caddy/Caddyfile, which defines no route for
# /api/v1/alertmanager/* or /api/v1/incidents/*/status at all) keeps
# producing real demo incidents. This is a deliberate, tested,
# documented choice (deploy/README.md's "legacy ingestion boundary"
# section) -- NOT a relaxation merely to pass the preflight check; a
# deployment that wants to disable the legacy demo pipeline entirely
# should set this to "false" and expect POST /internal/v1/alertmanager/
# webhook to fail closed (503).
CONTROL_PLANE_ALLOW_LEGACY_INGESTION=true

# ============================================================
# Trusted-proxy boundary for rate-limit-relevant client IP resolution
# (Phase 17A item 2 -- see deploy/README.md's own "trusted proxy"
# section for the full threat model and proof).
# ============================================================
# When enabled, control-plane trusts X-Forwarded-For ONLY on a
# connection whose REAL, observed TCP peer address resolves to one of
# TRUSTED_PROXY_HOSTS (Caddy's own container hostname on the internal
# Compose network) -- never a wildcard, never "all private addresses".
# Caddy itself (deploy/caddy/Caddyfile) OVERWRITES X-Forwarded-For
# with the real connecting client's address on every proxied request
# (never appends an untrusted client-supplied value), so the header is
# only ever trustworthy on that one hop.
TRUSTED_PROXY_ENABLED=true
TRUSTED_PROXY_HOSTS=caddy

# ============================================================
# SMTP (Better Auth email verification + password reset).
# A valid, non-placeholder SMTP configuration is REQUIRED by the
# preflight in deployment mode (see deploy/scripts/preflight.sh) --
# sign-in itself fails closed without it (see
# services/web-console/lib/auth/auth.ts's deployment-mode branch).
# For LOCAL PROOF (deploy/README.md), point this at the disposable,
# non-public test SMTP receiver deploy/scripts/test-smtp-receiver.py
# starts -- never a real mailbox for the proof run.
# ============================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# "starttls" (the common real-provider default on port 587),
# "tls" (implicit TLS, typically port 465), or "none" (plaintext --
# the local test-receiver proof ONLY; the preflight rejects "none"
# outside that explicit test mode).
SMTP_SECURITY=starttls

# ============================================================
# Telemetry retention (Phase 17A item 6).
# ============================================================
TELEMETRY_RETENTION_DAYS=30
# Default true: a scheduled run reports what it WOULD delete without
# deleting anything until this is explicitly set to "false" for a
# given invocation (deploy/scripts/retention-run.sh), or --execute is
# passed directly to scripts/prune-telemetry-samples.py.
TELEMETRY_RETENTION_DRY_RUN=true
TELEMETRY_RETENTION_BATCH_SIZE=5000
# How often the retention sidecar (deploy/docker-compose.yml's
# `retention-scheduler` service) runs a real (non-dry-run) pass.
TELEMETRY_RETENTION_INTERVAL_HOURS=24

# ============================================================
# Backup (Phase 17A item 5). Local directory only -- shipping this
# off-host is a documented Phase 17B operational requirement, never
# implemented or claimed as protection against host loss by this
# phase. See deploy/README.md's "Backup and restore" runbook.
# ============================================================
BACKUP_OUTPUT_DIR=./deploy/backups

# ============================================================
# Resource/log bounds (Phase 17A item 1) -- applied uniformly via
# deploy/docker-compose.yml's x-logging/x-deploy-resources anchors;
# overridable per environment without editing the compose file.
# ============================================================
DEPLOY_LOG_MAX_SIZE=10m
DEPLOY_LOG_MAX_FILES=3
