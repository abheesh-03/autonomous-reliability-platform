{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Notification service for the Autonomous Production Reliability Platform demo application. Provides a simulated notification trigger endpoint; no real delivery provider, event consumption, queue, or database access.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/health.test.ts test/notifications.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bootstrap.js"
  },
  "dependencies": {
    "@fastify/otel": "0.21.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
